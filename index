.cover span{color:#b9c7d9}
ul{list-style:none;margin:20px 0}
li{margin:12px 0;color:#dce5f1}
li:before{content:"✓";color:#63d59a;font-weight:900;margin-right:10px}
.cta{background:linear-gradient(135deg,#0f2845,#0b1727);border:1px solid #274c73;border-radius:20px;padding:50px 25px;text-align:center}
.cta p{color:#b9c7d9;margin:12px auto 25px;max-width:650px}
footer{text-align:center;padding:30px;color:#71839a;font-size:14px}
@media(max-width:750px){.cards,.book{grid-template-columns:1fr}.cover{max-width:330px;margin:auto}.container{padding:45px 18px}}
